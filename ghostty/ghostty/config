# =============================================================================
# Font
# =============================================================================
font-family = JetBrainsMono Nerd Font
font-size = 15

# =============================================================================
# Window
# =============================================================================
window-padding-x = 12
window-padding-y = 8
macos-titlebar-style = hidden
window-save-state = always

# Option key as Alt (same as alacritty option_as_alt = "Both")
macos-option-as-alt = true

# =============================================================================
# Cursor
# =============================================================================
cursor-style = block
cursor-style-blink = false
cursor-color = #E6B450
# Without this Ghostty switches the cursor to a bar at the prompt
shell-integration-features = no-cursor

# =============================================================================
# Mouse
# =============================================================================
mouse-hide-while-typing = true

# Copy selection to clipboard automatically
copy-on-select = true

# =============================================================================
# Notifications
# =============================================================================
# Ignore OSC 9/777 from programs: the only desktop alert is the Claude Code
# Stop hook (terminal-notifier), which does not go through the terminal
desktop-notifications = false

# =============================================================================
# Theme: Ayu dark
# =============================================================================
theme = Ayu
# Explicit so the terminal bg matches the tmux status bar 1:1
background = #0B0E14
# Brighter than Ayu's #BFBDB6: Claude Code replies use the default fg
foreground = #E8E6DD
# Claude Code draws secondary text faint (dim white): at the default 0.5 it
# sinks into the background
faint-opacity = 0.7
# Claude Code colors inline code and paths in replies from its base preset
# (dark-ansi: blueBright) and ignores custom theme overrides there, so bright
# blue becomes Ayu purple to match claude/themes/ayu.json
palette = 12=#D2A6FF

# =============================================================================
# Updates
# =============================================================================
# Cask is auto_updates, so brew/topgrade skip it: Ghostty updates itself
auto-update = download
auto-update-channel = stable
